## Benchmark suite for otp
## Part of the Alya Language package ecosystem (https://github.com/alya-lang)

import "std/test"
import "../src/lib.alya" as pkg

function main()
    let runner = bench_runner("otp Micro-Benchmarks")
    let secret = "GEZDGNBVGY3TQOJQGEZDGNBVGY3TQOJQ"

    # Bench 1: hotp() generation — 500 iterations (pure-Alya HMAC-SHA1)
    bench_start(runner, 500)
    let i = 0
    while i < 500
        pkg::hotp(secret, i)
        i += 1
    end
    bench_stop(runner, "hotp() 500 calls")

    # Bench 2: totp_at() fixed timestamp — 500 iterations
    bench_start(runner, 500)
    let j = 0
    while j < 500
        pkg::totp_at(secret, 59, 30, 0, 8)
        j += 1
    end
    bench_stop(runner, "totp_at() 8-digit 500 calls")

    # Bench 3: verify_hotp() exact counter — 500 iterations
    bench_start(runner, 500)
    let k = 0
    while k < 500
        pkg::verify_hotp(secret, "755224", 0)
        k += 1
    end
    bench_stop(runner, "verify_hotp() 500 calls")

    # Bench 4: counter_to_bytes() encoding — 50k iterations
    bench_start(runner, 50000)
    let m = 0
    while m < 50000
        pkg::counter_to_bytes(m)
        m += 1
    end
    bench_stop(runner, "counter_to_bytes() 50k calls")

    # Bench 5: config summary formatting — 50k iterations
    let cfg = pkg::new_totp_config("alice@example.com", "Example")
    bench_start(runner, 50000)
    let s = 0
    while s < 50000
        cfg.summary()
        s += 1
    end
    bench_stop(runner, "cfg.summary() 50k calls")

    bench_summary(runner)
end

main()
