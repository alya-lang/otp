## Test suite for otp
## Part of the Alya Language package ecosystem (https://github.com/alya-lang)

import "std/test"
import "crypto" as crypto
import "../src/lib.alya" as pkg

@cfg(feature = "uri")
function uri_error_path_throws() -> int
    try
        pkg::parse_otpauth_uri("https://example.com/x")
    catch err
        return true
    end
    return false
end

function main()
    test_suite("otp Test Suite")
    let r = runner_new()

    # ═══════════════════════════════════════════════════════════
    # 1. Algorithm Enum & Names
    # ═══════════════════════════════════════════════════════════
    runner_assert_eq(r, pkg::OtpAlgorithm.Sha1, 0, "OtpAlgorithm.Sha1 == 0")
    runner_assert_eq(r, pkg::OtpAlgorithm.Sha256, 1, "OtpAlgorithm.Sha256 == 1")
    runner_assert_eq(r, pkg::OtpAlgorithm.Sha512, 2, "OtpAlgorithm.Sha512 == 2")

    runner_assert_str_eq(r, pkg::algorithm_name(pkg::OtpAlgorithm.Sha1), "SHA1", "algorithm_name Sha1")
    runner_assert_str_eq(r, pkg::algorithm_name(pkg::OtpAlgorithm.Sha256), "SHA256", "algorithm_name Sha256")
    runner_assert_str_eq(r, pkg::algorithm_name(pkg::OtpAlgorithm.Sha512), "SHA512", "algorithm_name Sha512")
    runner_assert_str_eq(r, pkg::algorithm_name(), "SHA1", "algorithm_name defaults to SHA1")

    # ═══════════════════════════════════════════════════════════
    # 2. Config Factories & Methods
    # ═══════════════════════════════════════════════════════════
    let tcfg = pkg::new_totp_config("alice@example.com", "Example")
    runner_assert_str_eq(r, tcfg.label, "alice@example.com", "totp cfg label")
    runner_assert_str_eq(r, tcfg.issuer, "Example", "totp cfg issuer")
    runner_assert_eq(r, tcfg.digits, 6, "totp cfg digits default 6")
    runner_assert_eq(r, tcfg.period, 30, "totp cfg period default 30")
    runner_assert_eq(r, tcfg.algorithm, 0, "totp cfg algorithm default Sha1")
    runner_assert_eq(r, tcfg.is_valid(), true, "totp cfg is valid")
    runner_assert_eq(r, tcfg.is_hotp(), false, "totp cfg is not hotp")
    runner_assert_str_eq(r, tcfg.summary(), "Example:alice@example.com (6 digits, SHA1)", "totp cfg summary")
    runner_assert_true(r, len(tcfg.describe()) > 0, "totp cfg describe non-empty")

    let hcfg = pkg::new_hotp_config("bob", "Example", 8)
    runner_assert_eq(r, hcfg.digits, 8, "hotp cfg digits 8")
    runner_assert_eq(r, hcfg.period, 0, "hotp cfg period is 0")
    runner_assert_eq(r, hcfg.is_hotp(), true, "hotp cfg is hotp")
    runner_assert_str_eq(r, hcfg.summary(), "Example:bob (8 digits, SHA1)", "hotp cfg summary")

    let d7 = tcfg.with_digits(7)
    runner_assert_eq(r, d7.digits, 7, "with_digits updates digits")
    runner_assert_eq(r, tcfg.digits, 6, "original cfg digits immutable")
    let a2 = tcfg.with_algorithm(pkg::OtpAlgorithm.Sha256)
    runner_assert_eq(r, a2.algorithm, 1, "with_algorithm updates algorithm")

    let bad_cfg = pkg::new_totp_config("alice", "Example")
    bad_cfg.digits = 5
    runner_assert_eq(r, bad_cfg.is_valid(), false, "5-digit cfg is invalid")

    # ═══════════════════════════════════════════════════════════
    # 3. Counter Encoding
    # ═══════════════════════════════════════════════════════════
    let zero = pkg::counter_to_bytes(0)
    runner_assert_eq(r, len(zero), 8, "counter bytes length 8")
    runner_assert_eq(r, zero[7], 0, "counter 0 last byte 0")

    let one = pkg::counter_to_bytes(1)
    runner_assert_eq(r, one[7], 1, "counter 1 last byte 1")
    runner_assert_eq(r, one[0], 0, "counter 1 first byte 0")

    let b256 = pkg::counter_to_bytes(256)
    runner_assert_eq(r, b256[7], 0, "counter 256 last byte 0")
    runner_assert_eq(r, b256[6], 1, "counter 256 second byte 1")

    # ═══════════════════════════════════════════════════════════
    # 4. HOTP RFC 4226 Appendix D vectors (SHA1, 6 digits)
    #    Secret: ASCII "12345678901234567890"
    # ═══════════════════════════════════════════════════════════
    let rfc4226_key = crypto::str_to_bytes("12345678901234567890")
    let hotp_expected = ["755224", "287082", "359152", "969429", "338314", "254676", "287922", "162583", "399871", "520489"]
    let c = 0
    while c < 10
        let code = pkg::hotp_bytes(rfc4226_key, c)
        runner_assert_str_eq(r, code, hotp_expected[c], "RFC4226 HOTP counter " + str(c))
        c += 1
    end

    # Same vectors through the Base32 entry point
    let rfc4226_b32 = "GEZDGNBVGY3TQOJQGEZDGNBVGY3TQOJQ"
    runner_assert_str_eq(r, pkg::hotp(rfc4226_b32, 0), "755224", "hotp base32 counter 0")
    runner_assert_str_eq(r, pkg::hotp(rfc4226_b32, 9), "520489", "hotp base32 counter 9")
    runner_assert_eq(r, len(pkg::hotp(rfc4226_b32, 3, 8)), 8, "hotp 8-digit length")

    # ═══════════════════════════════════════════════════════════
    # 5. TOTP RFC 6238 Appendix B vectors (8 digits, step 30)
    # ═══════════════════════════════════════════════════════════
    runner_assert_str_eq(r, pkg::totp_at_bytes(rfc4226_key, 59, 30, 0, 8), "94287082", "RFC6238 SHA1 T=59")
    runner_assert_str_eq(r, pkg::totp_at_bytes(rfc4226_key, 1111111109, 30, 0, 8), "07081804", "RFC6238 SHA1 T=1111111109")
    runner_assert_str_eq(r, pkg::totp_at_bytes(rfc4226_key, 1111111111, 30, 0, 8), "14050471", "RFC6238 SHA1 T=1111111111")
    runner_assert_str_eq(r, pkg::totp_at_bytes(rfc4226_key, 1234567890, 30, 0, 8), "89005924", "RFC6238 SHA1 T=1234567890")
    runner_assert_str_eq(r, pkg::totp_at_bytes(rfc4226_key, 2000000000, 30, 0, 8), "69279037", "RFC6238 SHA1 T=2000000000")
    runner_assert_str_eq(r, pkg::totp_at_bytes(rfc4226_key, 20000000000, 30, 0, 8), "65353130", "RFC6238 SHA1 T=20000000000")

    let sha256_key = crypto::str_to_bytes("12345678901234567890123456789012")
    runner_assert_str_eq(r, pkg::totp_at_bytes(sha256_key, 59, 30, 0, 8, pkg::OtpAlgorithm.Sha256), "46119246", "RFC6238 SHA256 T=59")
    runner_assert_str_eq(r, pkg::totp_at_bytes(sha256_key, 1111111109, 30, 0, 8, pkg::OtpAlgorithm.Sha256), "68084774", "RFC6238 SHA256 T=1111111109")
    runner_assert_str_eq(r, pkg::totp_at_bytes(sha256_key, 2000000000, 30, 0, 8, pkg::OtpAlgorithm.Sha256), "90698825", "RFC6238 SHA256 T=2000000000")

    let sha512_key = crypto::str_to_bytes("1234567890123456789012345678901234567890123456789012345678901234")
    runner_assert_str_eq(r, pkg::totp_at_bytes(sha512_key, 59, 30, 0, 8, pkg::OtpAlgorithm.Sha512), "90693936", "RFC6238 SHA512 T=59")
    runner_assert_str_eq(r, pkg::totp_at_bytes(sha512_key, 1111111109, 30, 0, 8, pkg::OtpAlgorithm.Sha512), "25091201", "RFC6238 SHA512 T=1111111109")
    runner_assert_str_eq(r, pkg::totp_at_bytes(sha512_key, 2000000000, 30, 0, 8, pkg::OtpAlgorithm.Sha512), "38618901", "RFC6238 SHA512 T=2000000000")

    # Base32 entry point matches byte entry point
    runner_assert_str_eq(r, pkg::totp_at(rfc4226_b32, 59, 30, 0, 8), "94287082", "totp_at base32 T=59")

    # ═══════════════════════════════════════════════════════════
    # 6. Facade Wrappers (config-bound)
    # ═══════════════════════════════════════════════════════════
    let cfg8 = pkg::new_totp_config("alice", "Example", 8)
    runner_assert_str_eq(r, pkg::totp_for(cfg8, rfc4226_b32, 59), "94287082", "totp_for config wrapper")
    runner_assert_eq(r, pkg::verify_totp_for(cfg8, rfc4226_b32, "94287082", 59), 1, "verify_totp_for accepts")
    runner_assert_eq(r, pkg::verify_totp_for(cfg8, rfc4226_b32, "12345678", 59), 0, "verify_totp_for rejects")

    # ═══════════════════════════════════════════════════════════
    # 7. Verification & Windows
    # ═══════════════════════════════════════════════════════════
    runner_assert_eq(r, pkg::verify_hotp(rfc4226_b32, "755224", 0), 0, "verify_hotp exact counter")
    runner_assert_eq(r, pkg::verify_hotp(rfc4226_b32, "287082", 0, 3), 1, "verify_hotp window resync")
    runner_assert_eq(r, pkg::verify_hotp(rfc4226_b32, "000000", 0, 3), -1, "verify_hotp mismatch is -1")

    runner_assert_eq(r, pkg::verify_totp(rfc4226_b32, "94287082", 59, 1, 30, 0, 8), 1, "verify_totp exact step")
    runner_assert_eq(r, pkg::verify_totp(rfc4226_b32, "94287082", 89, 1, 30, 0, 8), 1, "verify_totp adjacent step window")
    runner_assert_eq(r, pkg::verify_totp(rfc4226_b32, "94287082", 59, 0, 30, 0, 8), 1, "verify_totp zero window exact")
    runner_assert_eq(r, pkg::verify_totp(rfc4226_b32, "00000000", 59, 1, 30, 0, 8), 0, "verify_totp mismatch is 0")

    # Live clock roundtrip (generation and verification share the clock)
    let live = pkg::totp_now(rfc4226_b32)
    runner_assert_eq(r, len(live), 6, "totp_now 6-digit length")
    runner_assert_eq(r, pkg::verify_totp_now(rfc4226_b32, live), 1, "verify_totp_now roundtrip")

    # ═══════════════════════════════════════════════════════════
    # 8. Secret Provisioning
    # ═══════════════════════════════════════════════════════════
    let fresh = pkg::generate_secret()
    runner_assert_eq(r, len(fresh), 32, "generate_secret default 32 chars")
    runner_assert_eq(r, len(crypto::base32_decode_bytes(fresh)), 20, "generate_secret decodes to 20 bytes")
    let short = pkg::generate_secret(10)
    runner_assert_eq(r, len(crypto::base32_decode_bytes(short)), 10, "generate_secret(10) decodes to 10 bytes")

    # ═══════════════════════════════════════════════════════════
    # 9. otpauth URIs (`uri` feature, default-on)
    # ═══════════════════════════════════════════════════════════
    @cfg(feature = "uri")
    let turi = pkg::build_otpauth_uri("totp", rfc4226_b32, tcfg)
    @cfg(feature = "uri")
    runner_assert_str_eq(r, turi, "otpauth://totp/Example:alice@example.com?secret=" + rfc4226_b32 + "&issuer=Example&digits=6&period=30&algorithm=SHA1", "build totp uri")
    @cfg(feature = "uri")
    let tparams = pkg::parse_otpauth_uri(turi)
    @cfg(feature = "uri")
    runner_assert_str_eq(r, tparams["kind"], "totp", "parsed kind")
    @cfg(feature = "uri")
    runner_assert_str_eq(r, tparams["label"], "alice@example.com", "parsed label")
    @cfg(feature = "uri")
    runner_assert_str_eq(r, tparams["issuer"], "Example", "parsed issuer")
    @cfg(feature = "uri")
    runner_assert_str_eq(r, tparams["secret"], rfc4226_b32, "parsed secret")
    @cfg(feature = "uri")
    runner_assert_eq(r, tparams["digits"], 6, "parsed digits")
    @cfg(feature = "uri")
    runner_assert_eq(r, tparams["period"], 30, "parsed period")

    @cfg(feature = "uri")
    let huri = pkg::build_otpauth_uri("hotp", rfc4226_b32, hcfg, 7)
    @cfg(feature = "uri")
    runner_assert_str_eq(r, huri, "otpauth://hotp/Example:bob?secret=" + rfc4226_b32 + "&issuer=Example&digits=8&counter=7&algorithm=SHA1", "build hotp uri")
    @cfg(feature = "uri")
    let hparams = pkg::parse_otpauth_uri(huri)
    @cfg(feature = "uri")
    runner_assert_eq(r, hparams["counter"], 7, "parsed counter")
    @cfg(feature = "uri")
    runner_assert_eq(r, hparams["algorithm"], pkg::OtpAlgorithm.Sha1, "parsed algorithm")

    # ═══════════════════════════════════════════════════════════
    # 10. Error Paths
    # ═══════════════════════════════════════════════════════════
    let threw = false
    try
        pkg::hotp(rfc4226_b32, -1)
    catch err
        threw = true
    end
    runner_assert_eq(r, threw, true, "negative counter throws")

    threw = false
    try
        pkg::hotp("!!!", 0)
    catch err
        threw = true
    end
    runner_assert_eq(r, threw, true, "empty secret throws")

    threw = false
    try
        pkg::hotp(rfc4226_b32, 0, 5)
    catch err
        threw = true
    end
    runner_assert_eq(r, threw, true, "5 digits throws")

    threw = false
    try
        pkg::make_totp_config("alice", "Example", 9)
    catch err
        threw = true
    end
    runner_assert_eq(r, threw, true, "9-digit config throws")

    threw = false
    try
        pkg::totp_at(rfc4226_b32, 10, 0)
    catch err
        threw = true
    end
    runner_assert_eq(r, threw, true, "zero step throws")

    @cfg(feature = "uri")
    runner_assert_eq(r, uri_error_path_throws(), true, "non-otpauth uri throws")

    let failed = runner_summary(r)
    if failed > 0
        exit(1)
    end
end

main()
