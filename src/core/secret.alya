## Shared Secret Provisioning & Validation
##
## Part of the Alya Language package ecosystem (https://github.com/alya-lang).
## Authenticator enrollment secret generation (Base32 and hex) plus
## syntactic validation, backed by `crypto::random_bytes` entropy.

import "crypto" as crypto

## Generates a fresh random shared secret for authenticator enrollment.
##
## Uses `crypto::random_bytes` and returns unpadded Base32, ready to embed
## in an `otpauth://` URI or QR code.
##
## ### Parameters
## - `length`: Random byte count (20 bytes is the interoperable default). Defaults to `20`.
##
## ### Returns
## Unpadded Base32-encoded secret string.
##
## ### Examples
## ```alya
## let secret = generate_secret() # e.g. "JBSWY3DPEHPK3PXP..."
## ```
pub function generate_secret(length: int = 20) -> string
    if length <= 0
        throw "length must be positive"
    end
    let raw = crypto::random_bytes(length)
    return crypto::base32_encode_bytes(raw, 0)
end

## Generates a fresh random shared secret encoded as lowercase hex.
##
## Useful for transports and stores that prefer hex over Base32
## (e.g. Steam-style provisioning and debugging fixtures).
##
## ### Parameters
## - `length`: Random byte count. Defaults to `20`.
##
## ### Returns
## Lowercase hex string of length `2 * length`.
##
## ### Examples
## ```alya
## let hex_secret = generate_secret_hex() # 40 hex chars
## ```
pub function generate_secret_hex(length: int = 20) -> string
    if length <= 0
        throw "length must be positive"
    end
    let raw = crypto::random_bytes(length)
    return crypto::bytes_to_hex(raw)
end

## Validates whether a string is a usable Base32-encoded shared secret.
##
## A secret is usable when it decodes to at least one byte. Decoding is
## case-insensitive and tolerates padding and whitespace; characters
## outside the Base32 alphabet are ignored (see `crypto::base32_decode_bytes`).
##
## ### Parameters
## - `secret`: Candidate Base32 secret string.
##
## ### Returns
## `true` when the secret decodes to a non-empty byte array, `false` otherwise.
##
## ### Examples
## ```alya
## let ok = is_valid_secret("GEZDGNBVGY3TQOJQGEZDGNBVGY3TQOJQ") # true
## ```
pub function is_valid_secret(secret: string) -> bool
    if secret is null or secret == ""
        return false
    end
    return len(crypto::base32_decode_bytes(secret)) > 0
end
