## TOTP Generation & Verification (RFC 6238)
##
## Part of the Alya Language package ecosystem (https://github.com/alya-lang).
## Time-based one-time passwords over HOTP with clock-step counters,
## verifier helpers with look-around windows, and secret provisioning.

import "crypto" as crypto
import "../types.alya"
import "./hotp.alya"

## Generates a TOTP value from raw secret bytes at an explicit timestamp.
##
## The counter is derived as `(timestamp - t0) / step` (RFC 6238 section 4).
##
## ### Parameters
## - `secret_bytes`: Shared secret byte array (must not be empty).
## - `timestamp`: Unix epoch seconds (must not precede `t0`).
## - `step`: Time step in seconds. Defaults to `30`.
## - `t0`: Start epoch offset. Defaults to `0`.
## - `digits`: Code length (6, 7, or 8). Defaults to `6`.
## - `algorithm`: Hash selector from `OtpAlgorithm`. Defaults to `OtpAlgorithm.Sha1`.
##
## ### Returns
## Zero-padded numeric code string of length `digits`.
##
## ### Examples
## ```alya
## let key = crypto::str_to_bytes("12345678901234567890")
## let code = totp_at_bytes(key, 59, 30, 0, 8) # "94287082"
## ```
pub function totp_at_bytes(secret_bytes, timestamp: int, step: int = 30, t0: int = 0, digits: int = 6, algorithm: int = OtpAlgorithm.Sha1) -> string
    if step <= 0
        throw "step must be positive"
    end
    if timestamp < t0
        throw "timestamp must not precede t0"
    end
    let counter = (timestamp - t0) / step
    return hotp_bytes(secret_bytes, counter, digits, algorithm)
end

## Generates a TOTP value from a Base32 secret at an explicit timestamp.
##
## ### Parameters
## - `secret`: Base32-encoded shared secret string.
## - `timestamp`: Unix epoch seconds.
## - `step`: Time step in seconds. Defaults to `30`.
## - `t0`: Start epoch offset. Defaults to `0`.
## - `digits`: Code length (6, 7, or 8). Defaults to `6`.
## - `algorithm`: Hash selector from `OtpAlgorithm`. Defaults to `OtpAlgorithm.Sha1`.
##
## ### Returns
## Zero-padded numeric code string of length `digits`.
pub function totp_at(secret: string, timestamp: int, step: int = 30, t0: int = 0, digits: int = 6, algorithm: int = OtpAlgorithm.Sha1) -> string
    let key = crypto::base32_decode_bytes(secret)
    return totp_at_bytes(key, timestamp, step, t0, digits, algorithm)
end

## Generates a TOTP value from a Base32 secret for the current time.
##
## Reads the system clock via the `time()` builtin (Unix epoch seconds).
##
## ### Parameters
## - `secret`: Base32-encoded shared secret string.
## - `step`: Time step in seconds. Defaults to `30`.
## - `t0`: Start epoch offset. Defaults to `0`.
## - `digits`: Code length (6, 7, or 8). Defaults to `6`.
## - `algorithm`: Hash selector from `OtpAlgorithm`. Defaults to `OtpAlgorithm.Sha1`.
##
## ### Returns
## Zero-padded numeric code string of length `digits`.
pub function totp_now(secret: string, step: int = 30, t0: int = 0, digits: int = 6, algorithm: int = OtpAlgorithm.Sha1) -> string
    return totp_at(secret, time(), step, t0, digits, algorithm)
end

## Verifies an HOTP code against a counter with a resynchronization window.
##
## Scans counters from `counter` to `counter + window`, comparing with a
## constant-time equality check.
##
## ### Parameters
## - `secret`: Base32-encoded shared secret string.
## - `code`: Candidate code string supplied by the user.
## - `counter`: Expected server-side counter.
## - `window`: Forward resync allowance in counters. Defaults to `0`.
## - `digits`: Code length (6, 7, or 8). Defaults to `6`.
## - `algorithm`: Hash selector from `OtpAlgorithm`. Defaults to `OtpAlgorithm.Sha1`.
##
## ### Returns
## The matched counter on success, `-1` when no counter in the window matches.
pub function verify_hotp(secret: string, code: string, counter: int, window: int = 0, digits: int = 6, algorithm: int = OtpAlgorithm.Sha1) -> int
    if window < 0
        throw "window must be non-negative"
    end
    let c = counter
    let last = counter + window
    while c <= last
        let candidate = hotp(secret, c, digits, algorithm)
        if crypto::constant_time_eq(candidate, code)
            return c
        end
        c += 1
    end
    return -1
end

## Verifies a TOTP code at an explicit timestamp with a look-around window.
##
## Scans steps from `window` behind to `window` ahead of the timestamp step.
##
## ### Parameters
## - `secret`: Base32-encoded shared secret string.
## - `code`: Candidate code string supplied by the user.
## - `timestamp`: Unix epoch seconds of the verification moment.
## - `window`: Step allowance in both directions. Defaults to `1`.
## - `step`: Time step in seconds. Defaults to `30`.
## - `t0`: Start epoch offset. Defaults to `0`.
## - `digits`: Code length (6, 7, or 8). Defaults to `6`.
## - `algorithm`: Hash selector from `OtpAlgorithm`. Defaults to `OtpAlgorithm.Sha1`.
##
## ### Returns
## `1` when a step in the window matches, `0` otherwise.
pub function verify_totp(secret: string, code: string, timestamp: int, window: int = 1, step: int = 30, t0: int = 0, digits: int = 6, algorithm: int = OtpAlgorithm.Sha1) -> bool
    if window < 0
        throw "window must be non-negative"
    end
    if step <= 0
        throw "step must be positive"
    end
    if timestamp < t0
        throw "timestamp must not precede t0"
    end
    let center = (timestamp - t0) / step
    let c = center - window
    if c < 0
        c = 0
    end
    let last = center + window
    while c <= last
        let candidate = hotp_bytes(crypto::base32_decode_bytes(secret), c, digits, algorithm)
        if crypto::constant_time_eq(candidate, code)
            return true
        end
        c += 1
    end
    return false
end

## Verifies a TOTP code against the current time with a look-around window.
##
## ### Parameters
## - `secret`: Base32-encoded shared secret string.
## - `code`: Candidate code string supplied by the user.
## - `window`: Step allowance in both directions. Defaults to `1`.
## - `step`: Time step in seconds. Defaults to `30`.
## - `t0`: Start epoch offset. Defaults to `0`.
## - `digits`: Code length (6, 7, or 8). Defaults to `6`.
## - `algorithm`: Hash selector from `OtpAlgorithm`. Defaults to `OtpAlgorithm.Sha1`.
##
## ### Returns
## `true` when a step in the window matches, `false` otherwise.
pub function verify_totp_now(secret: string, code: string, window: int = 1, step: int = 30, t0: int = 0, digits: int = 6, algorithm: int = OtpAlgorithm.Sha1) -> bool
    return verify_totp(secret, code, time(), window, step, t0, digits, algorithm)
end

## Generates a fresh random shared secret for authenticator enrollment.
##
## Uses `crypto::random_bytes` and returns unpadded Base32, ready to embed
## in an `otpauth://` URI or QR code.
##
## ### Parameters
## - `length`: Random byte count (20 bytes is the interoperable default). Defaults to `20`.
##
## ### Returns
## Unpadded Base32-encoded secret string.
##
## ### Examples
## ```alya
## let secret = generate_secret() # e.g. "JBSWY3DPEHPK3PXP..."
## ```
pub function generate_secret(length: int = 20) -> string
    if length <= 0
        throw "length must be positive"
    end
    let raw = crypto::random_bytes(length)
    return crypto::base32_encode_bytes(raw, 0)
end
