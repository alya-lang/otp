## otp Library Facade
##
## Part of the Alya Language package ecosystem (https://github.com/alya-lang).
## Serves as the primary public entry point and facade for the otp package,
## exposing RFC 4226 HOTP and RFC 6238 TOTP generation, verification,
## secret provisioning, and (feature-gated) `otpauth://` enrollment URIs.

import "./types.alya"
import "./core/hotp.alya"
import "./core/totp.alya"
import "./core/secret.alya"
import "./core/backup.alya"
import "./core/steam.alya"
@cfg(feature = "uri")
import "./core/uri.alya"

# ───────────────────────────────────────────────────────────────
# Primary Facade APIs
# ───────────────────────────────────────────────────────────────

## Constructs a new TOTP account configuration with specified or default values.
##
## ### Parameters
## - `label`: Account name. Defaults to `"user"`.
## - `issuer`: Provider or service name. Defaults to `""`.
## - `digits`: Code length (6, 7, or 8). Defaults to `6`.
## - `period`: Time step in seconds. Defaults to `30`.
## - `algorithm`: Hash selector from `OtpAlgorithm`. Defaults to `OtpAlgorithm.Sha1`.
##
## ### Returns
## A newly initialized `OtpConfig` instance.
##
## ### Examples
## ```alya
## let cfg = new_totp_config("alice@example.com", "Example")
## ```
pub function new_totp_config(label = "user", issuer: string = "", digits: int = 6, period: int = 30, algorithm: int = OtpAlgorithm.Sha1) -> OtpConfig
    return make_totp_config(label, issuer, digits, period, algorithm)
end

## Constructs a new HOTP account configuration with specified or default values.
##
## ### Parameters
## - `label`: Account name. Defaults to `"user"`.
## - `issuer`: Provider or service name. Defaults to `""`.
## - `digits`: Code length (6, 7, or 8). Defaults to `6`.
## - `algorithm`: Hash selector from `OtpAlgorithm`. Defaults to `OtpAlgorithm.Sha1`.
##
## ### Returns
## A newly initialized counter-based `OtpConfig` instance (`period` is `0`).
##
## ### Examples
## ```alya
## let cfg = new_hotp_config("alice@example.com", "Example")
## ```
pub function new_hotp_config(label = "user", issuer: string = "", digits: int = 6, algorithm: int = OtpAlgorithm.Sha1) -> OtpConfig
    return make_hotp_config(label, issuer, digits, algorithm)
end

## Generates a TOTP code for an account configuration at an explicit timestamp.
##
## Convenience wrapper combining `OtpConfig` parameters with `totp_at`.
##
## ### Parameters
## - `secret`: Base32-encoded shared secret string.
## - `cfg`: Account configuration (`OtpConfig`).
## - `timestamp`: Unix epoch seconds.
##
## ### Returns
## Zero-padded numeric code string of length `cfg.digits`.
##
## ### Examples
## ```alya
## let cfg = new_totp_config("alice", "Example")
## let code = totp_for(cfg, "JBSWY3DPEHPK3PXP", 59)
## ```
pub function totp_for(cfg: OtpConfig, secret: string, timestamp: int) -> string
    let step = cfg.period
    if step <= 0
        step = 30
    end
    return totp_at(secret, timestamp, step, 0, cfg.digits, cfg.algorithm)
end

## Generates a TOTP code for an account configuration for the current time.
##
## ### Parameters
## - `secret`: Base32-encoded shared secret string.
## - `cfg`: Account configuration (`OtpConfig`).
##
## ### Returns
## Zero-padded numeric code string of length `cfg.digits`.
pub function totp_now_for(cfg: OtpConfig, secret: string) -> string
    let step = cfg.period
    if step <= 0
        step = 30
    end
    return totp_now(secret, step, 0, cfg.digits, cfg.algorithm)
end

## Verifies a TOTP code for an account configuration at an explicit timestamp.
##
## ### Parameters
## - `secret`: Base32-encoded shared secret string.
## - `cfg`: Account configuration (`OtpConfig`).
## - `code`: Candidate code string supplied by the user.
## - `timestamp`: Unix epoch seconds of the verification moment.
## - `window`: Step allowance in both directions. Defaults to `1`.
##
## ### Returns
## `true` when a step in the window matches, `false` otherwise.
pub function verify_totp_for(cfg: OtpConfig, secret: string, code: string, timestamp: int, window: int = 1) -> bool
    let step = cfg.period
    if step <= 0
        step = 30
    end
    return verify_totp(secret, code, timestamp, window, step, 0, cfg.digits, cfg.algorithm)
end

# ───────────────────────────────────────────────────────────────
# Feature-Gated API Fallback Stubs
# ───────────────────────────────────────────────────────────────

# The slim-view stubs below keep the public API surface stable when the
# `uri` feature is disabled, so callers get a clear descriptive error
# instead of an undefined reference (params unused by design).
# alya-lint: disable unused-param
## Fallback stub for `build_otpauth_uri` when the `uri` feature is disabled.
##
## Rebuild with default features (or `--features uri`) for the full
## implementation in `src/core/uri.alya`.
@cfg(not(feature = "uri"))
pub function build_otpauth_uri(kind: string, secret: string, cfg: OtpConfig, counter: int = 0) -> string
    throw "uri feature is disabled (rebuild with default features or --features uri)"
end

## Fallback stub for `parse_otpauth_uri` when the `uri` feature is disabled.
##
## Rebuild with default features (or `--features uri`) for the full
## implementation in `src/core/uri.alya`.
@cfg(not(feature = "uri"))
pub function parse_otpauth_uri(uri: string) -> map
    throw "uri feature is disabled (rebuild with default features or --features uri)"
end
# alya-lint: enable unused-param
