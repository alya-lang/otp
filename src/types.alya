## otp Types & Data Structures
##
## Part of the Alya Language package ecosystem (https://github.com/alya-lang).
## Defines one-time password configuration models, hash algorithm selection,
## and associated constructors and methods (RFC 4226 HOTP, RFC 6238 TOTP).

# ───────────────────────────────────────────────────────────────
# Enumerations
# ───────────────────────────────────────────────────────────────

## Hash algorithms available for HMAC-based one-time passwords.
##
## `Sha1` is mandatory for HOTP (RFC 4226) and the interoperable default for
## TOTP; `Sha256` and `Sha512` are the RFC 6238 TOTP extensions.
pub enum OtpAlgorithm
    Sha1 = 0,
    Sha256 = 1,
    Sha512 = 2
end

# ───────────────────────────────────────────────────────────────
# Data Models (Structs)
# ───────────────────────────────────────────────────────────────

## One-time password account configuration shared by HOTP and TOTP.
##
## Holds the human-facing account identity (`issuer`, `label`) plus the
## code parameters (`digits`, `period`, `algorithm`). The secret itself is
## intentionally kept out of this struct and passed separately to the
## generator functions. `period` is `0` for HOTP accounts (counter-based,
## no time step).
##
## ### Fields
## - `issuer`: Provider or service name (e.g. `"Example"`).
## - `label`: Account name (e.g. `"alice@example.com"`).
## - `digits`: Code length, 6, 7, or 8.
## - `period`: TOTP time step in seconds (`0` for HOTP).
## - `algorithm`: Hash selector from `OtpAlgorithm`.
pub struct OtpConfig
    issuer: string,
    label: string,
    digits: int,
    period: int,
    algorithm: int
end

# ───────────────────────────────────────────────────────────────
# Private Helper Functions
# ───────────────────────────────────────────────────────────────

# Internal guard shared by the factory constructors.
function digits_valid_internal(digits: int) -> int
    if digits == 6 or digits == 7 or digits == 8
        return true
    end
    return false
end

# ───────────────────────────────────────────────────────────────
# Public Factories and Helpers
# ───────────────────────────────────────────────────────────────

## Returns the canonical uppercase digest name for an `OtpAlgorithm` value.
##
## ### Parameters
## - `algorithm`: Selector from `OtpAlgorithm`.
##
## ### Returns
## `"SHA1"`, `"SHA256"`, or `"SHA512"` (defaults to `"SHA1"`).
##
## ### Examples
## ```alya
## let name = algorithm_name(OtpAlgorithm.Sha256) # "SHA256"
## ```
pub function algorithm_name(algorithm: int = OtpAlgorithm.Sha1) -> string
    return when algorithm
        is OtpAlgorithm.Sha256 => "SHA256"
        is OtpAlgorithm.Sha512 => "SHA512"
        else => "SHA1"
    end
end

## Factory constructor creating a validated TOTP account configuration.
##
## ### Parameters
## - `label`: Account name. Defaults to `"user"`.
## - `issuer`: Provider or service name. Defaults to `""`.
## - `digits`: Code length (6, 7, or 8). Defaults to `6`.
## - `period`: Time step in seconds. Defaults to `30`.
## - `algorithm`: Hash selector from `OtpAlgorithm`. Defaults to `OtpAlgorithm.Sha1`.
##
## ### Returns
## A fully initialized `OtpConfig` instance.
##
## ### Examples
## ```alya
## let cfg = make_totp_config("alice@example.com", "Example")
## ```
pub function make_totp_config(label = "user", issuer: string = "", digits: int = 6, period: int = 30, algorithm: int = OtpAlgorithm.Sha1) -> OtpConfig
    if digits_valid_internal(digits) == false
        throw "digits must be 6, 7, or 8"
    end
    if period <= 0
        throw "period must be positive"
    end
    return OtpConfig {
        issuer: issuer,
        label: label,
        digits: digits,
        period: period,
        algorithm: algorithm
    }
end

## Factory constructor creating a validated HOTP account configuration.
##
## HOTP is counter-based, so `period` is fixed to `0` (not applicable).
##
## ### Parameters
## - `label`: Account name. Defaults to `"user"`.
## - `issuer`: Provider or service name. Defaults to `""`.
## - `digits`: Code length (6, 7, or 8). Defaults to `6`.
## - `algorithm`: Hash selector from `OtpAlgorithm`. Defaults to `OtpAlgorithm.Sha1`.
##
## ### Returns
## A fully initialized `OtpConfig` instance with `period` set to `0`.
##
## ### Examples
## ```alya
## let cfg = make_hotp_config("alice@example.com", "Example")
## ```
pub function make_hotp_config(label = "user", issuer: string = "", digits: int = 6, algorithm: int = OtpAlgorithm.Sha1) -> OtpConfig
    if digits_valid_internal(digits) == false
        throw "digits must be 6, 7, or 8"
    end
    return OtpConfig {
        issuer: issuer,
        label: label,
        digits: digits,
        period: 0,
        algorithm: algorithm
    }
end

# ───────────────────────────────────────────────────────────────
# Struct Methods: OtpConfig
# ───────────────────────────────────────────────────────────────

## Returns a formatted single-line summary of this configuration.
##
## ### Parameters
## - `self`: The target `OtpConfig` instance.
##
## ### Returns
## Summary string in the form `"Example:alice@example.com (6 digits, SHA1)"`.
pub function OtpConfig.summary(self: OtpConfig) -> string
    let who = self.label
    if self.issuer != ""
        who = self.issuer + ":" + self.label
    end
    return "{who} ({self.digits} digits, {algorithm_name(self.algorithm)})"
end

## Returns a detailed multi-attribute description of this configuration.
##
## ### Parameters
## - `self`: The target `OtpConfig` instance.
##
## ### Returns
## Detailed descriptive string including period and algorithm code.
pub function OtpConfig.describe(self: OtpConfig) -> string
    return "[OtpConfig] issuer={self.issuer}, label={self.label}, digits={self.digits}, period={self.period}, algorithm={self.algorithm}"
end

## Validates whether this configuration conforms to OTP constraints.
##
## ### Parameters
## - `self`: The target `OtpConfig` instance.
##
## ### Returns
## `1` if valid (non-empty label, digits 6-8, non-negative period), `0` otherwise.
pub function OtpConfig.is_valid(self: OtpConfig) -> int
    if self.label == "" or self.label is null
        return false
    end
    if digits_valid_internal(self.digits) == false
        return false
    end
    if self.period < 0
        return false
    end
    return true
end

## Returns 1 if this configuration is counter-based (HOTP), 0 otherwise.
##
## ### Parameters
## - `self`: The target `OtpConfig` instance.
##
## ### Returns
## `1` when `period` is `0`, `0` otherwise.
pub function OtpConfig.is_hotp(self: OtpConfig) -> int
    if self.period == 0
        return true
    end
    return false
end

## Returns a new configuration copy with an updated digit length.
##
## ### Parameters
## - `self`: The current `OtpConfig` instance.
## - `new_digits`: Replacement code length (6, 7, or 8).
##
## ### Returns
## A new `OtpConfig` instance with updated digits.
pub function OtpConfig.with_digits(self: OtpConfig, new_digits: int) -> OtpConfig
    if digits_valid_internal(new_digits) == false
        throw "digits must be 6, 7, or 8"
    end
    return OtpConfig {
        issuer: self.issuer,
        label: self.label,
        digits: new_digits,
        period: self.period,
        algorithm: self.algorithm
    }
end

## Returns a new configuration copy with an updated hash algorithm.
##
## ### Parameters
## - `self`: The current `OtpConfig` instance.
## - `new_algorithm`: Replacement selector from `OtpAlgorithm`.
##
## ### Returns
## A new `OtpConfig` instance with updated algorithm.
pub function OtpConfig.with_algorithm(self: OtpConfig, new_algorithm: int) -> OtpConfig
    return OtpConfig {
        issuer: self.issuer,
        label: self.label,
        digits: self.digits,
        period: self.period,
        algorithm: new_algorithm
    }
end
