## Example usage and walkthrough for otp
## Part of the Alya Language package ecosystem (https://github.com/alya-lang)

import "../src/lib.alya" as pkg

function main()
    say "=== otp Package Showcase ==="
    say ""

    let secret = "GEZDGNBVGY3TQOJQGEZDGNBVGY3TQOJQ"
    say "Shared secret (Base32): " + secret
    say ""

    # ───────────────────────────────────────────────────────────
    # 1. HOTP (RFC 4226)
    # ───────────────────────────────────────────────────────────
    say "--- 1. HOTP (counter-based) ---"
    say "hotp(counter=0): " + pkg::hotp(secret, 0)
    say "hotp(counter=1): " + pkg::hotp(secret, 1)
    say "hotp(counter=2): " + pkg::hotp(secret, 2)
    say ""

    # ───────────────────────────────────────────────────────────
    # 2. TOTP at a fixed timestamp (RFC 6238 vector)
    # ───────────────────────────────────────────────────────────
    say "--- 2. TOTP at T=59 (8 digits) ---"
    say "totp_at(T=59):  " + pkg::totp_at(secret, 59, 30, 0, 8)
    say ""

    # ───────────────────────────────────────────────────────────
    # 3. Live TOTP from the system clock
    # ───────────────────────────────────────────────────────────
    say "--- 3. Live TOTP (system clock) ---"
    let live = pkg::totp_now(secret)
    say "totp_now():      " + live
    say "verify (bool):   " + str(pkg::verify_totp_now(secret, live))
    say ""

    # ───────────────────────────────────────────────────────────
    # 4. Config-bound facade
    # ───────────────────────────────────────────────────────────
    say "--- 4. Config-Bound Facade ---"
    let cfg = pkg::new_totp_config("alice@example.com", "Example")
    say "Config:          " + cfg.summary()
    say "Code at T=59:    " + pkg::totp_for(cfg, secret, 59)
    say ""

    # ───────────────────────────────────────────────────────────
    # 5. Secret provisioning
    # ───────────────────────────────────────────────────────────
    say "--- 5. Fresh Secrets ---"
    say "generate_secret():     " + pkg::generate_secret()
    say "generate_secret_hex(): " + pkg::generate_secret_hex(8)
    say "is_valid_secret:       " + str(pkg::is_valid_secret(secret))
    say ""

    # ───────────────────────────────────────────────────────────
    # 6. Time-step countdown helpers
    # ───────────────────────────────────────────────────────────
    say "--- 6. Step Countdown ---"
    say "remaining now: " + str(pkg::totp_remaining_now()) + "s"
    say "elapsed now:   " + str(pkg::totp_elapsed_now()) + "s"
    say ""

    # ───────────────────────────────────────────────────────────
    # 7. Backup codes
    # ───────────────────────────────────────────────────────────
    say "--- 7. Backup Codes ---"
    let backups = pkg::generate_backup_codes(3, 8)
    say "code[0]: " + backups[0]
    say "verify:  " + str(pkg::verify_backup_code(backups, backups[0]))
    let rest = pkg::consume_backup_code(backups, backups[0])
    say "left after consume: " + str(len(rest))
    say ""

    # ───────────────────────────────────────────────────────────
    # 8. Steam Guard
    # ───────────────────────────────────────────────────────────
    say "--- 8. Steam Guard ---"
    let steam_b64 = "MTIzNDU2Nzg5MDEyMzQ1Njc4OTA="
    say "steam_guard(T=59): " + pkg::steam_guard(steam_b64, 59)
    say "live:              " + pkg::steam_guard_now(steam_b64)
    say ""

    # ───────────────────────────────────────────────────────────
    # 9. otpauth enrollment URI (`uri` feature, default-on)
    # ───────────────────────────────────────────────────────────
    say "--- 9. Enrollment URI ---"
    @cfg(feature = "uri")
    say "URI: " + pkg::build_otpauth_uri("totp", secret, cfg)
    @cfg(not(feature = "uri"))
    say "URI: (disabled — rebuild with --features uri)"
    say ""

    say "Done!"
end

main()
